dronbasicdoppler-noun","role":"Minion","challenge_value":7,"base_hit_points":20,"estimated_hit_points":145.6,"estimated_damage_min":22.5,"estimated_damage_max":45,"descriptions":null,"behavior":""},{"name":"Scaldron Basic Sinkhole","noun":"ScaldronBasicSinkhole","slug":"scaldronbasicsinkhole-noun","role":"Minion","challenge_value":6,"base_hit_points":22,"estimated_hit_points":160.2,"estimated_damage_min":28.2,"estimated_damage_max":45,"descriptions":null,"behavior":""},{"name":"Scaldron Basic Mines","noun":"ScaldronBasicMines","slug":"scaldronbasicmines-noun","role":"Minion","challenge_value":5,"base_hit_points":16,"estimated_hit_points":116.5,"estimated_damage_min":22.5,"estimated_damage_max":45,"descriptions":null,"behavior":""},{"name":"Scaldron Basic Thorno","noun":"ScaldronBasicThorno","slug":"scaldronbasicthorno-noun","role":"Minion","challenge_value":5,"base_hit_points":20,"estimated_hit_points":145.6,"estimated_damage_min":16.9,"estimated_damage_max":33.8,"descriptions":null,"behavior":""},{"name":"Scaldron Basic Blink","noun":"ScaldronBasicBlink","slug":"scaldronbasicblink-noun","role":"Minion","challenge_value":6,"base_hit_points":18,"estimated_hit_points":131,"estimated_damage_min":5.6,"estimated_damage_max":11.3,"descriptions":null,"behavior":""},{"name":"Grappling Pulsar","noun":"VerdanthSpecialThree","slug":"verdanthspecialthree-noun","role":"Lieutenant","challenge_value":35,"base_hit_points":140,"estimated_hit_points":1019.2,"descriptions":["Pull victims are slowed, then struck with rapid melee attacks."],"behavior":"The three-second Pulled modifier owns the forced-movement interval, then the phase uses the recovered nine-hit Fast Swipe while Puller cools."},{"name":"Invincitron","noun":"NomadWithDrone","slug":"nomadwithdrone-noun","role":"Lieutenant","challenge_value":30,"base_hit_points":110,"estimated_hit_points":800.8,"estimated_damage_min":28.2,"estimated_damage_max":45,"descriptions":["Has an orbiting drone that will shoot lasers at heroes.","At half health, will become invulnerable for a limited time."],"behavior":"One untargetable owner-bound NomadDrone uses the exact baseline SentryDroneLaser against the captain's current target and is deleted with its owner; the captain retains its strict-below-half ranked shield."},{"name":"Undermind","noun":"NomadScope","slug":"nomadscope-noun","role":"Lieutenant","challenge_value":30,"base_hit_points":80,"estimated_hit_points":582.4,"estimated_damage_min":11.3,"estimated_damage_max":22.5,"descriptions":["Ignites heroes, increases their Energy vulnerability, and gives allies a fiery buff."],"behavior":"Its fiery strike applies burning and stacking Energy vulnerability and projects the allied Energy-damage buff."},{"name":"Decelerator","noun":"NomadSnipe","slug":"nomadsnipe-noun","role":"Lieutenant","challenge_value":27,"base_hit_points":60,"estimated_hit_points":436.8,"descriptions":["Can instantly inflict a crippling debuff on nearby heroes, slowing their movement and attack speed.","Chases after slowed heroes and uses a physical melee attack."],"behavior":"Its six-second slow now enters the modifier inventory, reaches the client with the exact movement and attack operands, and contributes its movement operand to authoritative hero motion before the melee pursuit."},{"name":"Shade Drifter","noun":"NocturnaSpecialDrift","slug":"nocturnaspecialdrift-noun","role":"Lieutenant","challenge_value":39,"base_hit_points":100,"estimated_hit_points":728,"estimated_damage_min":45,"estimated_damage_max":78.8,"descriptions":["Difficult to hit physically; charges through and silences heroes; drains nearby life."],"behavior":"Noun Dodge Rating governs avoidance, the clipped through-target charge damages and silences every path contact, and each charge cycle pulses a local life-drain aura that heals the Drifter."},{"name":"Cannonator","noun":"ZelemBasicHybrid","slug":"zelembasichybrid-noun","role":"Minion","challenge_value":6,"base_hit_points":22,"estimated_hit_points":160.2,"estimated_damage_min":39.4,"estimated_damage_max":78.8,"descriptions":["Fires a large slow moving projectile when at a distance from his target.","When engaging in close combat, will switch to close range melee attacks."],"behavior":"Authored phase order selects the slow projectile beyond eight units and melee at eight or nearer."},{"name":"Haster","noun":"ZelemSpecialHaster","slug":"zelemspecialhaster-noun","role":"Lieutenant","challenge_value":30,"base_hit_points":100,"estimated_hit_points":728,"descriptions":["Can bend time to haste a nearby ally's movement and attack speed.","Has a moderately damaging projectile attack."],"behavior":"It deterministically selects the nearest living ally inside range 30, falls back to itself only when alone, applies the exact 20-second movement/attack/cooldown haste, then fires its recovered projectile."},{"name":"Raytheoid","noun":"ZelemSpecialThree","slug":"zelemspecialthree-noun","role":"Lieutenant","challenge_value":33,"base_hit_points":120,"estimated_hit_points":873.6,"estimated_damage_min":33.8,"estimated_damage_max":56.3,"descriptions":["Piercing lasers cross multiple heroes; buffs nearby allies’ energy damage."],"behavior":"The piercing path damages each contact once and resolves at the selected target, while the support branch applies one ranked Energy Damage buff per 30-second modifier cycle."},{"name":"Lightning Stalker","noun":"CryosBasicRanged","slug":"cryosbasicranged-noun","role":"Minion","challenge_value":5,"base_hit_points":18,"estimated_hit_points":131,"estimated_damage_min":5.6,"estimated_damage_max":45,"descriptions":["Slow-moving long-range orb shooter whose hits can briefly shock."],"behavior":"Its ranked projectile carries the authored shock chance and timed stun modifier."},{"name":"Quadrakiller","noun":"CryosSpecialOne","slug":"cryosspecialone-noun","role":"Lieutenant","challenge_value":30,"base_hit_points":130,"estimated_hit_points":946.4,"estimated_damage_min":11.3,"estimated_damage_max":39.4,"descriptions":["Fires lightning-orb volleys and becomes exhausted briefly afterward."],"behavior":"Its recovered four-shot burst retains the long release/exhaustion interval before the next action."}]}}
